{
  // opencode-cortex 全局配置示例
  // 放到 ~/.config/opencode/opencode-cortex.jsonc
  // 项目级配置放到 <项目>/.opencode/opencode-cortex.jsonc

  "storagePath": "~/.opencode-cortex",

  // 本地 transformers.js ONNX 模型，768 维，CLS pooling + 归一化
  "embeddingModel": "Xenova/bge-base-zh-v1.5",
  "embeddingDtype": "q8",
  "embeddingDimensions": 768,

  // 相似度 >= 0.92 拒绝新增并返回已有 id，提示用 update 合并
  "dedupRejectThreshold": 0.92,
  // 写入成功后返回最近 3 条相似度 >= 0.75 的条目，供宿主 AI 判断是否合并
  "dedupRelatedThreshold": 0.75,
  "dedupRelatedLimit": 3,

  // 额外敏感信息正则，命中 title/content/related_files/source_ref 即拒绝写入
  // 自动提取发送给模型前也会用同一组规则把命中片段替换为 [REDACTED]
  "blockedPatterns": [],

  // 开启后自动提取只写 <storagePath>/dry-run.jsonl，不写记忆库
  "autoCaptureDryRun": false,

  // 可选数据库加密；启用后未配置 key 时自动生成到 <storagePath>/db.key
  "databaseEncryptionEnabled": false,
  // "databaseEncryptionKey": "64 位十六进制字符，只能放全局配置",

  // 自动提取使用的固定模型；也可设为 "inherit" 跟随宿主默认模型
  "opencodeProvider": "opencode-go",
  "opencodeModel": "opencode-go/glm-5.3-flash",
  // 推理档位，glm-5.3-flash 支持 low / high / max
  "opencodeVariant": "low",

  // 记忆注入：first 仅会话首个请求，always 每个请求都注入
  // 注入内容为项目概览与 active 标题目录，不包含正文
  "injectOn": "first",
  "injectMaxTitles": 150,

  // 会话空闲后自动提取记忆；每次 idle 最多一次模型调用
  // 失败只记日志、不重试，不阻塞宿主会话
  "autoExtract": {
    "enabled": true,
    // 至少新增多少条用户消息才尝试提取
    "minNewMessages": 1,
    // 增量文本少于该字符数则跳过
    "minInputChars": 80,
    // 同一会话两次成功提取的最小间隔（分钟），0 表示不限制
    "cooldownMinutes": 10,
    // 瞬时失败（超时/限流/网络）后的冷却时间（分钟）
    // 同一增量最多尝试 2 次，之后推进水位
    "failureCooldownMinutes": 30,
    "maxInputChars": 12000,
    "maxAssistantChars": 4000,
    "maxMessages": 40,
    // 单次最多接受的条目数
    "maxItems": 10,
    // 单次模型调用超时（毫秒）
    "timeoutMs": 60000
  }
}
