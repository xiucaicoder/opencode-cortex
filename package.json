{
  "name": "opencode-cortex",
  "version": "0.1.0",
  "description": "Project-level business and architecture memory plugin for OpenCode",
  "type": "module",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "exports": {
    ".": {
      "import": "./dist/plugin.js",
      "types": "./dist/plugin.d.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bunx tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "import": "bun run scripts/import.ts",
    "export": "bun run scripts/export.ts",
    "smoke": "bun run scripts/smoke.ts"
  },
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "architecture",
    "business-rules"
  ],
  "author": "opencode-cortex",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@tursodatabase/database": "^0.8.3",
    "onnxruntime-node": "1.31.1",
    "@tursodatabase/database-common": "^0.8.3"
  },
  "//": "Pin latest stable onnxruntime-node@1.31.1 (direct + override) with @huggingface/transformers: nested OpenCode installs ignore package overrides (#184); Ort::Env teardown fix shipped in 1.24.1 (#225). Intel Mac (darwin/x64) is unsupported — @tursodatabase/database and fixed onnxruntime releases ship no x64 binding.",
  "overrides": {
    "onnxruntime-node": "1.31.1",
    "bun-types": "1.3.14"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.6",
    "@types/bun": "^1.4.3",
    "typescript": "6.0.3"
  },
  "opencode": {
    "type": "plugin"
  },
  "files": [
    "dist",
    "package.json",
    "scripts"
  ],
  "peerDependencies": {
    "@opencode/plugin": "^2.0.0"
  }
}
