{
  "name": "opencode-cortex",
  "version": "0.1.0",
  "description": "Project-level business and architecture memory plugin for OpenCode",
  "type": "module",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "exports": {
    ".": {
      "import": "./dist/plugin.js",
      "types": "./dist/plugin.d.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bunx tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "prepare": "husky"
  },
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "architecture",
    "business-rules"
  ],
  "author": "opencode-cortex",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@tursodatabase/database": "^0.8.3",
    "onnxruntime-node": "1.31.1"
  },
  "//": "Pin latest stable onnxruntime-node@1.31.1 (direct + override) with @huggingface/transformers: nested OpenCode installs ignore package overrides (#184); Ort::Env teardown fix shipped in 1.24.1 (#225). Intel Mac (darwin/x64) is unsupported \u2014 @tursodatabase/database and fixed onnxruntime releases ship no x64 binding.",
  "overrides": {
    "onnxruntime-node": "1.31.1",
    "bun-types": "1.3.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "@opencode/plugin": "^2.2.5"
  },
  "opencode": {
    "type": "plugin"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,jsonc,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.0"
  }
}
